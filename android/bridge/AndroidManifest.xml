<?xml version="1.0" encoding="utf-8"?>
<!--
  Mac Android Subsystem - the bridge app that runs inside Android.

  It has no screen. The Mac reads from its content provider with
  `content read` (URI content://io.github.harkhowalia1.msa.bridge/PATH) over ADB:
    version              the bridge's versionCode
    apps.json            launchable apps (package, activity, label, version, icon kind)
    icon/<package>       the app's icon as a 512x512 PNG (adaptive icons unmasked)
    notifications.json   active notifications, from NotificationRelayService
  Only the shell user (which holds DUMP) can read it, not other Android apps.

  MacInputMethod is Android's keyboard while it runs on the Mac: the Mac's
  windows send it what is typed, in any script (see MacInputMethod.java).

  Licensed under the GNU General Public License v3 or later.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.harkhowalia1.msa.bridge">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="Mac Bridge"
        android:allowBackup="false"
        android:hasCode="true">

        <provider
            android:name=".BridgeProvider"
            android:authorities="io.github.harkhowalia1.msa.bridge"
            android:exported="true"
            android:readPermission="android.permission.DUMP" />

        <service
            android:name=".NotificationRelayService"
            android:label="Mac notifications"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".MacInputMethod"
            android:label="Mac keyboard"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
